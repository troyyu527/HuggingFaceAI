# Copy to .env and fill in the values. Never commit .env.

# 1. OpenRouter — alternative (free models: 50 calls/day, 1,000/day after $10 credits)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# 2–4. Groq (fallback), Gemini (main; free tier only 20 calls/day per model), Cloudflare (alternative)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 5. Ollama — local testing only (any non-empty key)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b

# 6. Hugging Face — local WRITE token for uploads; the Space gets its own read-only token as a secret
HF_TOKEN=

# 7. Active LLM — what the app reads (keep below the providers so ${...} resolves)
# Main: Gemini. Fallback (tried when the main one fails before answering): Groq's models in order.
LLM_BASE_URL=${GEMINI_BASE_URL}
LLM_API_KEY=${GEMINI_API_KEY}
LLM_MODEL=${GEMINI_MODEL}
LLM_FALLBACK_BASE_URL=${GROQ_BASE_URL}
LLM_FALLBACK_API_KEY=${GROQ_API_KEY}
LLM_FALLBACK_MODEL=${GROQ_MODEL}

# 8. This project
KB_DATASET=troy0527/persona-kb
# Local development only: path to chunks.jsonl (not set on the Space)
CHUNKS_PATH=
